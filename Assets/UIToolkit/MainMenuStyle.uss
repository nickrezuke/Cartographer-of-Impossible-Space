:root {
}

.header {
    font-size: 140px;
  /* /* -unity-font: resource("Worldstar"); */
    color: rgb(255, 255, 255);
}

.button {
    width: 330px;
    height: 60px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-image: url("ButtonBackground.jpg");
    margin-top: 100px;
    margin-right: 0;
    margin-left: 250px;
    /* -unity-font: resource("Worldstar"); */
    font-size: 40px;
    color: rgb(255, 255, 255);
    transition-duration: 0.35s;
    transition-timing-function: ease-in-back;
}

.button:hover {
    scale: 1.1 1.1;
    -unity-background-image-tint-color: rgb(118, 84, 0);
}
